# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Fastrr loyalty program only (SmartCoins wallet) -- order checkout no
# longer goes through Fastrr/Shiprocket Checkout, see PayU below.
# Shared-secret token this app checks on the three loyalty callback routes
# (loyalty/points, loyalty/block, loyalty/unblock) -- those have no
# signature scheme of their own, so pick a random value here and register
# each URL in Fastrr's dashboard with ?token=<this value> appended, the
# same pattern used for the Shiprocket/Delhivery webhook tokens below.
FASTRR_LOYALTY_WEBHOOK_TOKEN=

# YouPI PG -- order checkout (UPI). Base URL + public key of your YouPI
# deployment; webhook secret signs payment confirmations sent to
# https://<your-domain>/api/youpi/webhook (set the same value in YouPI).
NEXT_PUBLIC_YOUPI_BASE_URL=
NEXT_PUBLIC_YOUPI_PUBLIC_KEY=
YOUPI_WEBHOOK_SECRET=

# PayU -- now used only for plan/subscription billing.
# From PayU dashboard -> Settings -> Merchant key & salt. Register
# https://<your-domain>/api/payu/webhook under Developers -> Webhooks.
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_MODE=test

# Delhivery -- courier auto-booking + tracking.
# Not self-serve: request a sandbox token from Vendordesk@delhivery.com or
# your BD/CS contact, then a production token after UAT.
DELHIVERY_API_TOKEN=
DELHIVERY_CLIENT_NAME=
DELHIVERY_MODE=test
DELHIVERY_WEBHOOK_TOKEN=

# AI -- one key covers every AI feature (chat via Gemini's OpenAI-compatible
# endpoint, plus native image enhancement). Get a free key at aistudio.google.com.
GEMINI_API_KEY=

# WhatsApp (MSG91) — optional, order-status notifications for opted-in buyers
MSG91_AUTH_KEY=
MSG91_WHATSAPP_INTEGRATED_NUMBER=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
