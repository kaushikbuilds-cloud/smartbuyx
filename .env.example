# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Fastrr / Shiprocket Checkout (order checkout -- replaces PayU for this).
# From Fastrr dashboard -> Settings -> API Keys, after enabling Checkout
# and registering the 3 catalog endpoints under Settings -> Custom Endpoints.
FASTRR_API_KEY=
FASTRR_SECRET_KEY=

# PayU (plan/subscription billing only -- order checkout uses Fastrr now)
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_MODE=test

# Shiprocket (delivery/courier auto-booking) -- self-serve, email/password
# login (not a static key). Per-seller pickup addresses are registered via
# each seller's own dashboard, not an env var here.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_WEBHOOK_TOKEN=

# Delhivery -- dormant/unused for now (kept in case of switching back).
# Not self-serve: request a sandbox token from Vendordesk@delhivery.com or
# your BD/CS contact, then a production token after UAT.
DELHIVERY_API_TOKEN=
DELHIVERY_CLIENT_NAME=
DELHIVERY_MODE=test
DELHIVERY_WEBHOOK_TOKEN=

# AI -- one key covers every AI feature (chat via Gemini's OpenAI-compatible
# endpoint, plus native image enhancement). Get a free key at aistudio.google.com.
GEMINI_API_KEY=

# WhatsApp (MSG91) — optional, order-status notifications for opted-in buyers
MSG91_AUTH_KEY=
MSG91_WHATSAPP_INTEGRATED_NUMBER=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
